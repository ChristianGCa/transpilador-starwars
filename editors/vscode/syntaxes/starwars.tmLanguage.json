{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Star Wars",
  "scopeName": "source.starwars",
  "fileTypes": [
    "starwars"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#for-header"
    },
    {
      "include": "#prefix-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#number"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.starwars",
      "match": "#.*$"
    },
    "string": {
      "name": "string.quoted.double.starwars",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.starwars",
          "match": "\\\\[\"\\\\nrt]"
        },
        {
          "name": "invalid.illegal.escape.starwars",
          "match": "\\\\."
        }
      ]
    },
    "function-definition": {
      "begin": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])(Execute a ordem 66)(?![A-Za-z_À-ÖØ-öø-ÿ0-9])\\s*([A-Za-z_À-ÖØ-öø-ÿ][A-Za-z_À-ÖØ-öø-ÿ0-9]*)?\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "storage.type.function.starwars"
        },
        "2": {
          "name": "entity.name.function.definition.starwars"
        },
        "3": {
          "name": "punctuation.section.parens.begin.starwars"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.starwars"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "([A-Za-z_À-ÖØ-öø-ÿ][A-Za-z_À-ÖØ-öø-ÿ0-9]*)\\s*(:)",
          "captures": {
            "1": {
              "name": "variable.parameter.starwars"
            },
            "2": {
              "name": "punctuation.separator.type.starwars"
            }
          }
        },
        {
          "include": "#types"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "for-header": {
      "match": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])(This is the way)(?![A-Za-z_À-ÖØ-öø-ÿ0-9])\\s*(\\()\\s*([A-Za-z_À-ÖØ-öø-ÿ][A-Za-z_À-ÖØ-öø-ÿ0-9]*)",
      "captures": {
        "1": {
          "name": "keyword.control.loop.starwars"
        },
        "2": {
          "name": "punctuation.section.parens.begin.starwars"
        },
        "3": {
          "name": "variable.other.declaration.starwars"
        }
      }
    },
    "types": {
      "name": "storage.type.starwars",
      "match": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])(?:Eu sou C3PO, ciborgue de relações humanas|Você era o escolhido)(?![A-Za-z_À-ÖØ-öø-ÿ0-9])"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.block.starwars",
          "match": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])(?:Há muito tempo, em uma galáxia muito, muito distante|Chewie, estamos em casa|INICIA_SISTEMA|LOGOUT)(?![A-Za-z_À-ÖØ-öø-ÿ0-9])"
        },
        {
          "name": "keyword.control.conditional.starwars",
          "match": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])(?:Faça, ou não faça|Tentativa não há)(?![A-Za-z_À-ÖØ-öø-ÿ0-9])"
        },
        {
          "name": "keyword.control.loop.starwars",
          "match": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])(?:Eu sinto uma perturbação na força|This is the way|de|até)(?![A-Za-z_À-ÖØ-öø-ÿ0-9])"
        },
        {
          "name": "keyword.control.return.starwars",
          "match": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])(?:Palpatine retornou)(?![A-Za-z_À-ÖØ-öø-ÿ0-9])"
        },
        {
          "name": "storage.type.function.starwars",
          "match": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])(?:Execute a ordem 66)(?![A-Za-z_À-ÖØ-öø-ÿ0-9])"
        },
        {
          "name": "support.function.io.starwars",
          "match": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])(?:Hello There|Ajude\\-me Obi\\-Wan Kenobi)(?![A-Za-z_À-ÖØ-öø-ÿ0-9])"
        },
        {
          "include": "#types"
        },
        {
          "name": "keyword.operator.assignment.starwars",
          "match": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])(?:Eu alterei o acordo)(?![A-Za-z_À-ÖØ-öø-ÿ0-9])"
        },
        {
          "name": "keyword.operator.arithmetic.starwars",
          "match": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])(?:Que a força esteja com você|Acabou anakin|Eu sou todos os jedi|Eu sou todos os sith)(?![A-Za-z_À-ÖØ-öø-ÿ0-9])"
        },
        {
          "name": "keyword.operator.comparison.starwars",
          "match": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])(?:Estes não são os droides que você procura|Como deve ser|I have the high ground|A força é forte nele|Você subestima meu poder|Não, eu sou seu pai)(?![A-Za-z_À-ÖØ-öø-ÿ0-9])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.starwars",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.starwars",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.assignment.starwars",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.starwars",
          "match": "[+\\-*/]"
        }
      ]
    },
    "declaration": {
      "match": "([A-Za-z_À-ÖØ-öø-ÿ][A-Za-z_À-ÖØ-öø-ÿ0-9]*)\\s*(:)",
      "captures": {
        "1": {
          "name": "variable.other.declaration.starwars"
        },
        "2": {
          "name": "punctuation.separator.type.starwars"
        }
      }
    },
    "function-call": {
      "match": "([A-Za-z_À-ÖØ-öø-ÿ][A-Za-z_À-ÖØ-öø-ÿ0-9]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.starwars"
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.starwars",
          "match": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])[0-9]+\\.[0-9]+(?![A-Za-z_À-ÖØ-öø-ÿ0-9])"
        },
        {
          "name": "constant.numeric.integer.starwars",
          "match": "(?<![A-Za-z_À-ÖØ-öø-ÿ0-9])[0-9]+(?![A-Za-z_À-ÖØ-öø-ÿ0-9])"
        }
      ]
    },
    "variable": {
      "name": "variable.other.starwars",
      "match": "[A-Za-z_À-ÖØ-öø-ÿ][A-Za-z_À-ÖØ-öø-ÿ0-9]*"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.starwars",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.starwars",
          "match": ","
        },
        {
          "name": "punctuation.separator.type.starwars",
          "match": ":"
        },
        {
          "name": "punctuation.section.parens.starwars",
          "match": "[()]"
        }
      ]
    },
    "prefix-declaration": {
      "match": "((?<![A-Za-z_À-ÖØ-öø-ÿ0-9])(?:Eu sou C3PO, ciborgue de relações humanas|Você era o escolhido)(?![A-Za-z_À-ÖØ-öø-ÿ0-9]))\\s+(?!Eu alterei o acordo(?![A-Za-z_À-ÖØ-öø-ÿ0-9]))([A-Za-z_À-ÖØ-öø-ÿ][A-Za-z_À-ÖØ-öø-ÿ0-9]*)",
      "captures": {
        "1": {
          "name": "storage.type.starwars"
        },
        "2": {
          "name": "variable.other.declaration.starwars"
        }
      }
    }
  }
}
