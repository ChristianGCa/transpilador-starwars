# Simulador de treinamento do Esquadrão Rogue

# resto da divisão inteira (a linguagem não tem operador de resto)
Execute a ordem 66 resto(a: Você era o escolhido, b: Você era o escolhido): Você era o escolhido
    Palpatine retornou a Acabou anakin (a Eu sou todos os sith b) Eu sou todos os jedi b;
Chewie, estamos em casa

# formações possíveis do esquadrão: fatorial recursivo
Execute a ordem 66 formacoes(n: Você era o escolhido): Você era o escolhido
    Faça, ou não faça (n Não, eu sou seu pai 1)
        Palpatine retornou 1;
    Tentativa não há
        Palpatine retornou n Eu sou todos os jedi formacoes(n Acabou anakin 1);
    Chewie, estamos em casa
Chewie, estamos em casa

# nota do piloto: pontos ponderados pela precisão (em %)
Execute a ordem 66 nota(pontos: Você era o escolhido, precisao: Eu sou C3PO, ciborgue de relações humanas): Eu sou C3PO, ciborgue de relações humanas
    Palpatine retornou pontos Eu sou todos os jedi precisao Eu sou todos os sith 100.0;
Chewie, estamos em casa

# procedimento: mostra a patente conforme a nota
Execute a ordem 66 patente(valor: Eu sou C3PO, ciborgue de relações humanas)
    Faça, ou não faça (valor Você subestima meu poder 0.0)
        Hello There ("\tpatente: inválida\n");
        Palpatine retornou;
    Chewie, estamos em casa
    Faça, ou não faça (valor A força é forte nele 80.0)
        Hello There ("\tpatente: \"Jedi\"\n");
    Tentativa não há
        Faça, ou não faça (valor I have the high ground 50.0)
            Hello There ("\tpatente: Padawan\n");
        Tentativa não há
            Hello There ("\tpatente: Youngling\n");
        Chewie, estamos em casa
    Chewie, estamos em casa
Chewie, estamos em casa

